<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEON_HEX // ORBITAL_SURVIVAL</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;900&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Default Neon Mode */
            --neon: #ff00ff;
            --neon-alt: #00ffff;
            --bg: #050505;
            --player: #fff;
            --ui-text: #fff;
        }

        /* Dark Mode (Stealth) */
        [data-theme="stealth"] {
            --neon: #444;
            --neon-alt: #222;
            --bg: #000;
            --player: #00ffff;
            --ui-text: #666;
        }

        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%;
            background: var(--bg); color: var(--ui-text);
            font-family: 'Orbitron', sans-serif;
            overflow: hidden; display: flex; align-items: center; justify-content: center;
            transition: background 0.5s ease;
        }

        #ui {
            position: absolute; top: 30px; left: 30px; z-index: 10;
            pointer-events: none;
        }

        .stat { margin-bottom: 10px; }
        .label { font-size: 0.6rem; color: var(--neon-alt); letter-spacing: 2px; }
        .value { font-size: 2rem; font-weight: 900; text-shadow: 0 0 15px var(--neon-alt); }

        /* Mode Toggle */
        #theme-switcher {
            position: absolute; top: 30px; right: 30px; z-index: 101;
            background: transparent; border: 1px solid var(--neon-alt);
            color: var(--neon-alt); padding: 5px 10px; font-family: 'Orbitron';
            cursor: pointer; font-size: 0.7rem;
        }

        #overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9); display: flex; flex-direction: column;
            align-items: center; justify-content: center; z-index: 100;
        }

        h1 { font-size: 4rem; margin: 0; text-shadow: 0 0 20px var(--neon); color: var(--neon); text-align: center; }
        .msg { color: var(--neon-alt); margin: 20px 0; letter-spacing: 5px; font-size: 0.8rem; }
        
        .start-btn {
            padding: 15px 50px; background: transparent; border: 2px solid var(--neon);
            color: var(--neon); font-family: 'Orbitron'; font-weight: 900;
            cursor: pointer; transition: 0.3s; letter-spacing: 3px;
        }
        .start-btn:hover { background: var(--neon); color: #000; box-shadow: 0 0 40px var(--neon); }

        canvas { display: block; }
        #highScoreBox { margin-top: 15px; color: #fff; font-size: 0.7rem; letter-spacing: 1px; opacity: 0.8; }
    </style>
</head>
<body>

    <button id="theme-switcher" onclick="toggleTheme()">MODE: NEON</button>

    <div id="ui">
        <div class="stat">
            <div class="label">SYNC_INDEX</div>
            <div id="score" class="value">0</div>
        </div>
        <div class="stat">
            <div class="label">STABILITY</div>
            <div id="health" class="value" style="color: var(--neon);">100%</div>
        </div>
        <div class="stat">
            <div class="label">RECORD_PEAK</div>
            <div id="highScoreDisplay" class="value" style="font-size: 1.2rem; opacity: 0.7;">0</div>
        </div>
    </div>

    <div id="overlay">
        <h1 id="header">NEON_HEX</h1>
        <div class="msg">ORBIT THE CORE // FIND THE GAP</div>
        <button class="start-btn" onclick="startGame()">INIT_CORE</button>
        <div id="highScoreBox">BEST_SYNC: <span id="bestVal">0</span></div>
    </div>

    <canvas id="gameCanvas"></canvas>

<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const scoreEl = document.getElementById('score');
    const healthEl = document.getElementById('health');
    const overlay = document.getElementById('overlay');
    const header = document.getElementById('header');
    const highScoreDisplay = document.getElementById('highScoreDisplay');
    const bestVal = document.getElementById('bestVal');
    const themeBtn = document.getElementById('theme-switcher');

    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    let gameActive = false;
    let score = 0;
    let health = 100;
    let playerAngle = 0;
    let rotationSpeed = 0.09;
    let walls = [];
    let frame = 0;
    let wallSpeed = 4;
    let spawnRate = 80;

    // Persist High Score
    let highScore = localStorage.getItem('neonHexHighScore') || 0;
    bestVal.innerText = highScore;
    highScoreDisplay.innerText = highScore;

    // Theme Management
    function toggleTheme() {
        const current = document.documentElement.getAttribute('data-theme');
        if (current === 'stealth') {
            document.documentElement.removeAttribute('data-theme');
            themeBtn.innerText = "MODE: NEON";
        } else {
            document.documentElement.setAttribute('data-theme', 'stealth');
            themeBtn.innerText = "MODE: STEALTH";
        }
    }

    class Wall {
        constructor() {
            this.dist = Math.max(canvas.width, canvas.height) / 1.5;
            this.gapSize = Math.random() * 0.8 + 0.6; // Size of the safe opening
            this.angle = Math.random() * Math.PI * 2;
            this.color = Math.random() > 0.5 ? getComputedStyle(document.documentElement).getPropertyValue('--neon').trim() : getComputedStyle(document.documentElement).getPropertyValue('--neon-alt').trim();
        }

        draw() {
            ctx.strokeStyle = this.color;
            ctx.shadowBlur = 15;
            ctx.shadowColor = this.color;
            ctx.lineWidth = 10;
            ctx.beginPath();
            // We draw the wall, leaving the gap empty
            ctx.arc(canvas.width/2, canvas.height/2, this.dist, this.angle + this.gapSize, this.angle);
            ctx.stroke();
        }

        update() {
            this.dist -= wallSpeed;
        }
    }

    function startGame() {
        score = 0;
        health = 100;
        walls = [];
        frame = 0;
        gameActive = true;
        overlay.style.display = 'none';
        animate();
    }

    const keys = {};
    window.addEventListener('keydown', e => keys[e.code] = true);
    window.addEventListener('keyup', e => keys[e.code] = false);

    function animate() {
        if (!gameActive) return;
        frame++;

        // Clear with slight trail
        ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--bg');
        ctx.globalAlpha = 0.3;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.globalAlpha = 1.0;

        // Player Movement
        if (keys['ArrowLeft'] || keys['KeyA']) playerAngle -= rotationSpeed;
        if (keys['ArrowRight'] || keys['KeyD']) playerAngle += rotationSpeed;

        const px = canvas.width/2 + Math.cos(playerAngle) * 60;
        const py = canvas.height/2 + Math.sin(playerAngle) * 60;
        
        ctx.shadowBlur = 20;
        const playerColor = getComputedStyle(document.documentElement).getPropertyValue('--player');
        ctx.shadowColor = playerColor;
        ctx.fillStyle = playerColor;
        ctx.beginPath();
        ctx.arc(px, py, 8, 0, Math.PI * 2);
        ctx.fill();

        // Spawn Walls
        if (frame % Math.floor(spawnRate) === 0) {
            walls.push(new Wall());
        }

        // Difficulty Scaling
        wallSpeed = 4 + (score / 2000);
        spawnRate = Math.max(25, 80 - (score / 500));

        walls.forEach((wall, i) => {
            wall.update();
            wall.draw();

            // Collision Check (When wall passes the player radius)
            if (wall.dist < 70 && wall.dist > 50) {
                let normPlayer = ((playerAngle % (Math.PI * 2)) + (Math.PI * 2)) % (Math.PI * 2);
                let start = ((wall.angle % (Math.PI * 2)) + (Math.PI * 2)) % (Math.PI * 2);
                let end = (((wall.angle + wall.gapSize) % (Math.PI * 2)) + (Math.PI * 2)) % (Math.PI * 2);

                let inGap = false;
                if (start < end) {
                    if (normPlayer > start && normPlayer < end) inGap = true;
                } else {
                    if (normPlayer > start || normPlayer < end) inGap = true;
                }

                if (!inGap) {
                    health -= 20;
                    walls.splice(i, 1);
                    // Flash effect
                    ctx.fillStyle = "white";
                    ctx.fillRect(0,0, canvas.width, canvas.height);
                }
            }

            // Score point and remove wall
            if (wall.dist < 10) {
                walls.splice(i, 1);
                score += 100;
            }
        });

        scoreEl.innerText = score;
        healthEl.innerText = health + "%";

        if (health <= 0) {
            endGame();
            return;
        }

        requestAnimationFrame(animate);
    }

    function endGame() {
        gameActive = false;
        if (score > highScore) {
            highScore = score;
            localStorage.setItem('neonHexHighScore', highScore);
            bestVal.innerText = highScore;
            highScoreDisplay.innerText = highScore;
        }
        header.innerText = "CORE_COLLAPSED";
        overlay.style.display = 'flex';
    }

    window.addEventListener('resize', () => {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    });
</script>
</body>
</html>
